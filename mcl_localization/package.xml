<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>mcl_localization</name>
  <version>1.0.0</version>
  <description>
    Monte Carlo Localization (particle filter) over a known 2D occupancy grid,
    using an odometry motion model and a likelihood-field range-finder model.
  </description>

  <maintainer email="abhinavthakare99@gmail.com">Abhinav Thakare</maintainer>
  <license>BSD-3-Clause</license>

  <author email="abhinavthakare99@gmail.com">Abhinav Thakare</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!--
    An earlier package.xml declared NO build or exec dependencies at all --
    only buildtool_depend on catkin -- so `rosdep install` installed nothing
    and a clean build failed. All of these are now declared explicitly.
  -->
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Needed by the launch file, so declared as runtime dependencies. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_cmake_cpplint</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
