Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /ParticleCloud1
      Splitter Ratio: 0.5
    Tree Height: 700
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 40
      Color: 160; 160; 164
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Color Scheme: map
      Draw Behind: true
    - Class: rviz_default_plugins/PoseArray
      Name: ParticleCloud
      Enabled: true
      Topic:
        Value: /particlecloud
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 1
      Shape: Arrow (Flat)
      Arrow Length: 0.3
      Color: 0; 192; 0
      Alpha: 0.5
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: MclPose
      Enabled: true
      Topic:
        Value: /mcl_pose
        Durability Policy: Volatile
        Reliability Policy: Reliable
        Depth: 1
      Color: 255; 25; 0
      Covariance:
        Value: true
        Position:
          Alpha: 0.3
          Color: 204; 51; 204
        Orientation:
          Alpha: 0.5
          Color: 255; 255; 127
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan
        Durability Policy: Volatile
        Reliability Policy: Best Effort
        Depth: 5
      Size (m): 0.05
      Color: 255; 255; 0
      Color Transformer: FlatColor
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: true
      Show Axes: true
      Marker Scale: 1
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    # "2D Pose Estimate" publishes to /initialpose, which is how the filter
    # is seeded. Global initialization is unreliable on symmetric maps.
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: TopDownOrtho
      Scale: 25
      Target Frame: <Fixed Frame>
      X: 16
      Y: 16
Window Geometry:
  Height: 900
  Width: 1400
  Displays:
    collapsed: false
